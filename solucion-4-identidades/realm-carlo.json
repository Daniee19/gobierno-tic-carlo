{
  "realm": "carlo",
  "displayName": "CARLO - Identidades del personal",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,

  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and passwordHistory(3) and notUsername",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,

  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,

  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    }
  ],

  "roles": {
    "realm": [
      { "name": "admin_ti",  "description": "Administrador de TI: acceso total a los sistemas" },
      { "name": "gerente",   "description": "Gerencia: consulta de información y dashboards" },
      { "name": "inspector", "description": "Registra inspecciones de vehículos en Verificarlo" },
      { "name": "vendedor",  "description": "Consulta vehículos y gestiona clientes en HubSpot" },
      { "name": "auditor",   "description": "Solo lectura de logs y reportes de auditoría" }
    ]
  },

  "clients": [
    {
      "clientId": "verificarlo-app",
      "name": "Verificarlo (app demo)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "${DEMO_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5000/callback"],
      "webOrigins": ["http://localhost:5000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5000/*"
      }
    },
    {
      "clientId": "powerbi-carlo",
      "name": "Power BI (dashboard)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://app.powerbi.com/*"],
      "webOrigins": ["https://app.powerbi.com"]
    },
    {
      "clientId": "hubspot-carlo",
      "name": "HubSpot (SSO por SAML)",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": true,
      "redirectUris": ["https://api.hubspot.com/login-api/v1/saml/login*"],
      "attributes": {
        "saml_name_id_format": "email",
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false"
      }
    }
  ]
}
